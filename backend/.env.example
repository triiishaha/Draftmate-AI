# Copy to .env (never commit .env)

# Legal research and citation verification (Indian Kanoon)
INDIANKANOON_API_TOKEN=

# Optional: AI summaries in research, and AI-assisted citation finding
ANTHROPIC_API_KEY=

# Drafting engine (/draft/run). Leave LLM_MODEL empty for dry-run mode (no model called).
LLM_PROVIDER=anthropic
LLM_MODEL=

# Document pipeline answers (/document/process)
GEMINI_API_KEY=

# Extra browser origins allowed to call this backend, comma separated (optional)
# DRAFTMATE_CORS=http://localhost:3000,http://localhost:5173

# Where templates and versions are stored (optional)
# DRAFTMATE_DB=
